# Copy to .env.docker and fill in real secrets before running `docker compose up`.
# Unlike .env.example (for running the app on your host machine), hostnames here
# use the Compose service names (postgres, redis) instead of localhost.

DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tododb
TEST_DB_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/tododb_test

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECRET_ACCESS_KEY=
SECRET_REFRESH_KEY=
ALGORITHM=HS256

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

MAIL_USERNAME=
MAIL_FROM=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

TESTING=false
EMAIL_SERVICE_ACTIVE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
